---
import { GitMerge } from 'lucide-preact';
import projects from '../data/oss-projects.json';
import { fetchMergedPrs, fetchOssProjects } from '../lib-prs';

const { items: prs } = await fetchMergedPrs('vinirib');
const ago = (iso: string) => {
  const days = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 86400000));
  return days === 0 ? 'today' : days === 1 ? 'yesterday' : days < 30 ? `${days} days ago` : `${Math.round(days / 30)} mo ago`;
};
const entries = Object.entries(await fetchOssProjects(projects));
---

<section class="section" id="open-source" aria-labelledby="oss-title">
  <div class="container">
    <p class="eyebrow">03 / Open source</p>
    <h2 id="oss-title">I fix the libraries I use</h2>
    <p class="lead">Pull requests to the tools other teams depend on: contract testing, OpenAPI, Java frameworks and AI agents.</p>
    <ul class="oss">
      {entries.map(([repo, p]) => (
        <li>
          <a href={`https://github.com/${repo}/pulls?q=author%3Avinirib`} target="_blank" rel="noopener">
            <span class="oss-head">
              <GitMerge size={16} strokeWidth={1.5} />
              <strong>{repo.split('/')[1]}</strong>
              <span class="oss-owner">{repo.split('/')[0]}</span>
            </span>
            <span class="oss-what">{p.what}</span>
            <span class="oss-doing">{p.doing}</span>
          </a>
        </li>
      ))}
    </ul>
    {prs.length > 0 && (
      <div class="merged">
        <p class="eyebrow">Recently merged</p>
        <ul>
          {prs.map((pr) => (
            <li>
              <a href={pr.url} target="_blank" rel="noopener">
                <span class="merged-repo">{pr.repo}</span>
                <span class="merged-title">{pr.title}</span>
                <span class="merged-when">{pr.mergedAt ? ago(pr.mergedAt) : ''}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .oss {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .oss a {
    display: grid;
    gap: 8px;
    height: 100%;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    transition: border-color 200ms var(--ease), transform 200ms var(--ease);
  }

  .oss a:hover {
    border-color: var(--accent-text);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .oss-head {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--success);
  }

  .oss-head strong {
    font: 600 15px/1.2 var(--font-mono);
    color: var(--text);
  }

  .oss-owner {
    margin-left: auto;
    font: 500 12px/1 var(--font-mono);
    color: var(--text-subtle);
  }

  .oss-what {
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .oss-doing {
    font-size: 14px;
    line-height: 1.5;
  }

  .merged {
    margin-top: 32px;
  }

  .merged ul {
    display: grid;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .merged a {
    display: grid;
    grid-template-columns: 220px 1fr auto;
    gap: 16px;
    padding: 12px 4px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 15px;
  }

  .merged a:hover {
    background: var(--surface);
    text-decoration: none;
  }

  .merged-repo,
  .merged-when {
    font: 500 13px/1.6 var(--font-mono);
    color: var(--text-subtle);
  }

  .merged-repo::before {
    content: '⑂ ';
    color: var(--success);
  }

  @media (max-width: 700px) {
    .merged a {
      grid-template-columns: 1fr auto;
    }

    .merged-title {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (max-width: 900px) {
    .oss {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .oss {
      grid-template-columns: 1fr;
    }
  }
</style>
