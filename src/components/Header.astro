---
import { Moon, Sun } from 'lucide-preact';
import BrandIcon from './BrandIcon.astro';
import { site } from '../site';

const sections = [
  { id: 'playground', label: 'playground' },
  { id: 'about', label: 'about' },
  { id: 'open-source', label: 'open source' },
  { id: 'career', label: 'career' },
  { id: 'work', label: 'work with me' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="#top" class="wordmark" aria-label="vinirib, back to top">
      <span class="wordmark-dot" aria-hidden="true"></span>vinirib
    </a>
    <nav class="nav" aria-label="Sections">
      {sections.map((s) => <a href={`#${s.id}`} data-section={s.id}>{s.label}</a>)}
    </nav>
    <div class="header-tools">
      <span class="load-badge" id="load-badge" hidden>LOAD: 11</span>
      <button class="icon-btn kbd-btn" type="button" data-action="open-palette" aria-label="Open command palette (Cmd+K)">⌘K</button>
      <button class="icon-btn kbd-btn" type="button" data-action="open-terminal" aria-label="Open terminal (backtick key)">&gt;_</button>
      <a class="icon-btn" href={site.linkedin} target="_blank" rel="me noopener" aria-label="LinkedIn profile"><BrandIcon name="linkedin" /></a>
      <a class="icon-btn" href={site.github} target="_blank" rel="me noopener" aria-label="GitHub profile"><BrandIcon name="github" /></a>
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle light and dark theme">
        <span class="theme-icon-dark"><Moon size={16} strokeWidth={1.5} /></span>
        <span class="theme-icon-light"><Sun size={16} strokeWidth={1.5} /></span>
      </button>
    </div>
  </div>
  <nav class="subnav" aria-label="Sections">
    {sections.map((s) => <a href={`#${s.id}`} data-section={s.id}>{s.label}</a>)}
  </nav>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  const links = document.querySelectorAll<HTMLAnchorElement>('[data-section]');
  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.section === entry.target.id));
        const chip = document.querySelector<HTMLAnchorElement>(`.subnav [data-section="${entry.target.id}"]`);
        if (chip?.offsetParent) chip.parentElement?.scrollTo({ left: chip.offsetLeft - 24, behavior: 'smooth' });
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  document.querySelectorAll('main section[id]').forEach((section) => spy.observe(section));

  const badge = document.getElementById('load-badge');
  window.addEventListener('system:load', (event) => {
    const level = (event as CustomEvent<{ level: number }>).detail.level;
    if (badge) badge.hidden = level < 11;
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
  }

  .header-inner {
    height: 56px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 600 16px/1 var(--font-mono);
    color: var(--text);
  }

  .wordmark:hover {
    text-decoration: none;
  }

  .wordmark-dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--accent);
  }

  .nav {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }

  .nav a,
  .subnav a {
    position: relative;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font: 500 14px/1 var(--font-mono);
    color: var(--text-muted);
    white-space: nowrap;
    transition: color 150ms var(--ease), background-color 150ms var(--ease);
  }

  .nav a:hover,
  .subnav a:hover {
    color: var(--text);
    background: var(--surface-2);
    text-decoration: none;
  }

  .nav a[aria-current],
  .subnav a[aria-current] {
    color: var(--text);
  }

  .nav a[aria-current]::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: -11px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent-text);
  }

  .subnav {
    display: none;
  }

  .subnav a[aria-current] {
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .load-badge {
    font: 600 12px/1 var(--font-mono);
    letter-spacing: 0.08em;
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--on-accent);
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: border-color 150ms var(--ease), color 150ms var(--ease);
  }

  .icon-btn:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .kbd-btn {
    width: auto;
    padding: 0 10px;
    font: 600 12px/1 var(--font-mono);
  }

  .theme-icon-light {
    display: none;
  }

  :global(:root[data-theme='light']) .theme-icon-light {
    display: inline;
  }

  :global(:root[data-theme='light']) .theme-icon-dark {
    display: none;
  }

  @media (max-width: 1000px) {
    .nav {
      display: none;
    }

    .header-tools {
      margin-left: auto;
    }

    .subnav {
      display: flex;
      gap: 6px;
      padding: 0 24px 10px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .subnav::-webkit-scrollbar {
      display: none;
    }
  }
</style>
