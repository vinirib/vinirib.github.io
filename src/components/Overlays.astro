---
import projects from '../data/oss-projects.json';
import { mailto, site } from '../site';
import { fetchOssProjects } from '../lib-prs';

const oss = Object.fromEntries(
  Object.entries(await fetchOssProjects(projects)).map(([repo, p]) => [
    repo.split('/')[1],
    { repo, ...p },
  ]),
);
const config = { email: site.email, linkedin: site.linkedin, github: site.github, mailto: mailto(), oss };
---

<div class="incident-banner" id="incident-banner" hidden role="status">
  <strong>SEV2</strong> Visitor too curious. Status: investigating. <button type="button" data-action="incident-off">resolve</button>
</div>
<div class="chaos-pill" id="chaos-pill" hidden role="status">chaos monkey active · <button type="button" data-action="chaos-off">stop</button></div>

<dialog class="palette" id="palette" aria-label="Command palette">
  <input id="palette-input" type="text" placeholder="Type a command or search..." autocomplete="off" spellcheck="false" aria-controls="palette-list" />
  <ul id="palette-list" role="listbox"></ul>
  <p class="palette-foot"><kbd>↑</kbd><kbd>↓</kbd> move <kbd>enter</kbd> run <kbd>esc</kbd> close</p>
</dialog>

<dialog class="term" id="terminal" aria-label="Terminal">
  <div class="term-bar"><span></span><span></span><span></span><p>guest@vinirib: ~</p></div>
  <div class="term-out" id="term-out" aria-live="polite"></div>
  <label class="term-line"><span class="term-prompt">$</span><input id="term-input" type="text" autocomplete="off" spellcheck="false" aria-label="Terminal command" /></label>
</dialog>

<script is:inline type="application/json" id="site-config" set:html={JSON.stringify(config)} />

<script>
  type Oss = Record<string, { repo: string; what: string; doing: string }>;
  const cfg = JSON.parse(document.getElementById('site-config')?.textContent ?? '{}') as {
    email: string;
    linkedin: string;
    github: string;
    mailto: string;
    oss: Oss;
  };
  const root = document.documentElement;

  const setTheme = (theme: 'dark' | 'light') => {
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {}
  };
  const setIncident = (on: boolean) => {
    root.dataset.mode = on ? 'incident' : '';
    document.getElementById('incident-banner')!.hidden = !on;
  };
  const setChaos = (on: boolean) => {
    document.getElementById('chaos-pill')!.hidden = !on;
    window.dispatchEvent(new CustomEvent('playground:chaos', { detail: { on } }));
    if (on) document.getElementById('playground')?.scrollIntoView({ behavior: 'smooth' });
  };
  const copyEmail = async () => {
    try {
      await navigator.clipboard.writeText(cfg.email);
      return true;
    } catch {
      return false;
    }
  };
  const go = (id: string) => document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });

  document.addEventListener('click', (event) => {
    const action = (event.target as HTMLElement).closest('[data-action]')?.getAttribute('data-action');
    if (action === 'incident-off') setIncident(false);
    if (action === 'chaos-off') setChaos(false);
    if (action === 'open-palette') openPalette();
    if (action === 'open-terminal') openTerminal();
  });

  // command palette
  const palette = document.getElementById('palette') as HTMLDialogElement;
  const input = document.getElementById('palette-input') as HTMLInputElement;
  const list = document.getElementById('palette-list') as HTMLUListElement;
  const commands: Array<{ group: string; label: string; run: () => void }> = [
    { group: 'Work', label: 'Start a project (email)', run: () => (location.href = cfg.mailto) },
    { group: 'Work', label: 'Copy email address', run: () => void copyEmail() },
    { group: 'Work', label: 'Open LinkedIn', run: () => window.open(cfg.linkedin, '_blank', 'noopener') },
    { group: 'Work', label: 'Open GitHub', run: () => window.open(cfg.github, '_blank', 'noopener') },
    { group: 'Go to', label: 'Playground', run: () => go('playground') },
    { group: 'Go to', label: 'What I do', run: () => go('about') },
    { group: 'Go to', label: 'Open source', run: () => go('open-source') },
    { group: 'Go to', label: 'Career', run: () => go('career') },
    { group: 'Go to', label: 'Work with me', run: () => go('work') },
    { group: 'Break things', label: 'Kill a random node', run: () => (go('playground'), window.dispatchEvent(new Event('playground:kill-random'))) },
    { group: 'Break things', label: 'Toggle chaos monkey', run: () => setChaos(document.getElementById('chaos-pill')!.hidden === true) },
    { group: 'Break things', label: 'Toggle incident mode', run: () => setIncident(root.dataset.mode !== 'incident') },
    { group: 'Settings', label: 'Toggle light / dark theme', run: () => setTheme(root.dataset.theme === 'light' ? 'dark' : 'light') },
    { group: 'Settings', label: 'Open terminal', run: () => openTerminal() },
  ];
  let filtered = commands;
  let active = 0;

  const render = () => {
    const q = input.value.trim().toLowerCase();
    filtered = commands.filter((c) => `${c.group} ${c.label}`.toLowerCase().includes(q));
    active = Math.min(active, Math.max(0, filtered.length - 1));
    list.innerHTML = '';
    filtered.forEach((c, i) => {
      const li = document.createElement('li');
      li.role = 'option';
      li.ariaSelected = String(i === active);
      li.className = i === active ? 'active' : '';
      li.innerHTML = `<span>${c.label}</span><small>${c.group}</small>`;
      li.addEventListener('click', () => runCommand(i));
      li.addEventListener('mousemove', () => {
        if (active !== i) {
          active = i;
          render();
        }
      });
      list.appendChild(li);
    });
    if (filtered.length === 0) list.innerHTML = '<li class="none">No match. Try "chaos".</li>';
  };
  const runCommand = (i: number) => {
    const cmd = filtered[i];
    palette.close();
    cmd?.run();
  };
  function openPalette() {
    if (terminal.open) terminal.close();
    input.value = '';
    active = 0;
    render();
    palette.showModal();
    input.focus();
  }
  input.addEventListener('input', () => {
    active = 0;
    render();
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') active = (active + 1) % Math.max(1, filtered.length);
    else if (e.key === 'ArrowUp') active = (active - 1 + filtered.length) % Math.max(1, filtered.length);
    else if (e.key === 'Enter') return runCommand(active);
    else return;
    e.preventDefault();
    render();
  });
  palette.addEventListener('click', (e) => e.target === palette && palette.close());

  // terminal
  const terminal = document.getElementById('terminal') as HTMLDialogElement;
  const out = document.getElementById('term-out') as HTMLDivElement;
  const tInput = document.getElementById('term-input') as HTMLInputElement;
  const history: string[] = [];
  let cursor = 0;

  const print = (text: string, cls = '') => {
    const line = document.createElement('pre');
    line.className = cls;
    line.textContent = text;
    out.appendChild(line);
    out.scrollTop = out.scrollHeight;
  };
  const ossNames = Object.keys(cfg.oss);
  const help = [
    'help              this list',
    'whoami            who is this guy',
    'ls                what is here',
    'ls oss            open source projects',
    'cat oss/<name>    what I did there, e.g. cat oss/pact-jvm',
    'contact           email and LinkedIn',
    'sudo hire-me      start a project',
    'chaos             toggle chaos monkey in the playground',
    'incident          declare an incident',
    'theme dark|light  switch theme',
    'play              warm up the amp',
    'clear, exit',
  ].join('\n');

  const run = (raw: string) => {
    const cmd = raw.trim();
    print(`$ ${cmd}`, 'cmd');
    if (!cmd) return;
    history.push(cmd);
    cursor = history.length;
    const [name, ...args] = cmd.split(/\s+/);
    const arg = args.join(' ');
    switch (name) {
      case 'help':
        return print(help);
      case 'whoami':
        return print('Vinícius Ribeiro. Senior Backend Engineer, São Paulo, remote.\nDistributed systems, APIs and AI-assisted engineering. 10+ years in production.\nOpen to B2B contracts worldwide.');
      case 'ls':
        if (arg === 'oss') return print(ossNames.join('  '));
        return print('playground/  about/  oss/  career/  work-with-me/  resume.pdf (nice try, see LinkedIn)');
      case 'cat': {
        const key = arg.replace(/^oss\//, '');
        const p = cfg.oss[key];
        if (!p) return print(`cat: ${arg || '?'}: no such file. Try: ls oss`, 'err');
        return print(`${p.repo}\n${p.what}\n> ${p.doing}`);
      }
      case 'contact':
        return print(`email     ${cfg.email}\nlinkedin  ${cfg.linkedin}`);
      case 'sudo':
        if (arg === 'hire-me') {
          print('[sudo] password for guest: ********\nPermission granted. Opening your email client...', 'ok');
          setTimeout(() => (location.href = cfg.mailto), 900);
          return;
        }
        return print('guest is not in the sudoers file. This incident will be reported.', 'err');
      case 'hire':
      case 'hire-me':
        return print('Permission denied. Try: sudo hire-me', 'err');
      case 'chaos': {
        const on = document.getElementById('chaos-pill')!.hidden === true;
        setChaos(on);
        return print(on ? 'chaos monkey released. Watch the playground.' : 'chaos monkey back in its cage.', on ? 'err' : 'ok');
      }
      case 'incident':
        setIncident(root.dataset.mode !== 'incident');
        return print(root.dataset.mode === 'incident' ? 'SEV2 declared. Paging the on-call (it is me).' : 'Incident resolved. Writing the postmortem.', 'err');
      case 'theme':
        if (arg === 'dark' || arg === 'light') {
          setTheme(arg);
          return print(`theme set to ${arg}`, 'ok');
        }
        return print('usage: theme dark|light', 'err');
      case 'play':
        return print('\\m/ Turning the amp up... the playground Load knob goes to 11. Try it.');
      case 'rm':
        return print('rm: nice try. Production is protected by code review.', 'err');
      case 'clear':
        out.innerHTML = '';
        return;
      case 'exit':
        terminal.close();
        return;
      default:
        return print(`${name}: command not found. Type help.`, 'err');
    }
  };

  function openTerminal() {
    if (palette.open) palette.close();
    if (!out.childElementCount) print('Welcome. Type help to see what you can do here.');
    terminal.showModal();
    tInput.focus();
  }
  tInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      run(tInput.value);
      tInput.value = '';
    } else if (e.key === 'ArrowUp' && history.length) {
      cursor = Math.max(0, cursor - 1);
      tInput.value = history[cursor];
    } else if (e.key === 'ArrowDown') {
      cursor = Math.min(history.length, cursor + 1);
      tInput.value = history[cursor] ?? '';
    } else if (e.key === 'Tab') {
      e.preventDefault();
      const words = ['help', 'whoami', 'ls', 'cat oss/', 'contact', 'sudo hire-me', 'chaos', 'incident', 'theme ', 'play', 'clear', 'exit', ...ossNames.map((n) => `cat oss/${n}`)];
      const match = words.find((w) => w.startsWith(tInput.value) && w !== tInput.value);
      if (match) tInput.value = match;
    } else return;
  });
  terminal.addEventListener('click', (e) => {
    if (e.target === terminal) terminal.close();
    else tInput.focus();
  });

  // global keys: cmd+k, backtick, konami
  const konami = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  let progress = 0;
  window.addEventListener('keydown', (e) => {
    const typing = e.target instanceof Element && e.target.closest('input, textarea, select, [contenteditable]');
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      palette.open ? palette.close() : openPalette();
      return;
    }
    if (typing) return;
    if (e.key === '`') {
      e.preventDefault();
      openTerminal();
      return;
    }
    progress = e.key === konami[progress] ? progress + 1 : e.key === konami[0] ? 1 : 0;
    if (progress === konami.length) {
      progress = 0;
      setChaos(true);
    }
  });

  console.log(
    '%c vinirib %c You opened DevTools. You are my kind of person.\n Type hire() or press ` for the terminal.',
    'background:#4f46e5;color:#fff;padding:4px 8px;border-radius:4px;font-weight:600',
    'color:inherit',
  );
  (window as unknown as { hire: () => string }).hire = () => {
    location.href = cfg.mailto;
    return 'Opening your email client. Talk soon.';
  };
</script>

<style>
  .incident-banner {
    position: sticky;
    top: 56px;
    z-index: 19;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    background: var(--error);
    color: #111;
    font: 500 13px/1.3 var(--font-mono);
  }

  .incident-banner button,
  .chaos-pill button {
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .incident-banner[hidden],
  .chaos-pill[hidden] {
    display: none;
  }

  .chaos-pill {
    position: fixed;
    left: 50%;
    bottom: 20px;
    z-index: 40;
    transform: translateX(-50%);
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--warning);
    color: #111;
    font: 600 12px/1 var(--font-mono);
    box-shadow: var(--overlay-shadow);
  }

  dialog {
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--overlay-shadow);
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(2px);
  }

  .palette {
    width: min(560px, calc(100vw - 32px));
    margin-top: 14vh;
  }

  .palette input {
    width: 100%;
    padding: 18px 20px;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    font: 500 16px/1 var(--font-mono);
    outline: none;
  }

  .palette ul {
    max-height: 360px;
    overflow-y: auto;
    margin: 0;
    padding: 6px;
    list-style: none;
  }

  .palette :global(li) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    font-size: 15px;
    cursor: pointer;
  }

  .palette :global(li small) {
    font: 500 11px/1 var(--font-mono);
    color: var(--text-subtle);
  }

  .palette :global(li.active) {
    background: var(--surface-2);
    box-shadow: inset 2px 0 0 var(--accent-text);
  }

  .palette :global(li.none) {
    color: var(--text-subtle);
    cursor: default;
  }

  .palette-foot {
    margin: 0;
    padding: 10px 16px;
    border-top: 1px solid var(--border);
    font: 500 11px/1 var(--font-mono);
    color: var(--text-subtle);
  }

  kbd {
    margin-right: 4px;
    padding: 2px 5px;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    font: inherit;
  }

  .term {
    width: min(760px, calc(100vw - 32px));
    background: #07080c;
    color: #d7dae2;
    font: 500 14px/1.6 var(--font-mono);
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid #1c202b;
  }

  .term-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #2f3546;
  }

  .term-bar p {
    margin: 0 auto;
    font-size: 12px;
    color: #6b7385;
  }

  .term-out {
    height: min(380px, 55vh);
    overflow-y: auto;
    padding: 14px 16px 0;
  }

  .term-out :global(pre) {
    margin: 0 0 8px;
    white-space: pre-wrap;
    font: inherit;
  }

  .term-out :global(.cmd) {
    color: #a5b4fc;
  }

  .term-out :global(.err) {
    color: #f87171;
  }

  .term-out :global(.ok) {
    color: #34d399;
  }

  .term-line {
    display: flex;
    gap: 10px;
    padding: 10px 16px 16px;
  }

  .term-prompt {
    color: #34d399;
  }

  .term-line input {
    flex: 1;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    outline: none;
  }
</style>
