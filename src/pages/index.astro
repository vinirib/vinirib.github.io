---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhatIDo from '../components/WhatIDo.astro';
import OpenSource from '../components/OpenSource.astro';
import Career from '../components/Career.astro';
import WorkWithMe from '../components/WorkWithMe.astro';
import Footer from '../components/Footer.astro';
import Overlays from '../components/Overlays.astro';
import Playground from '../playground/Playground';
---

<Base>
  <Header />
  <Overlays />
  <main>
    <Hero />
    <section class="section" id="playground" aria-labelledby="playground-title">
      <div class="container">
        <p class="eyebrow">01 / Playground</p>
        <h2 id="playground-title">Break my payment system</h2>
        <p class="lead">
          A client pays $42 through a gateway and two replicas. Follow the missions, or break things your way. Every step
          is explained below the diagram.
        </p>
        <Playground client:visible />
      </div>
    </section>
    <WhatIDo />
    <OpenSource />
    <Career />
    <WorkWithMe />
  </main>
  <Footer />
</Base>
